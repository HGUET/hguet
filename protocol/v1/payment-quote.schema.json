{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hguet.fr/schemas/v1/payment-quote.schema.json",
  "title": "HGUET signed native SOL price quote — unreleased draft",
  "description": "Domain HGUET-SOL-QUOTE/v1, JCS canonical bytes, accountless single paid Cloud check.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "quote_id",
    "environment",
    "network",
    "genesis_hash",
    "asset",
    "receiver",
    "memo_reference",
    "message_sha256",
    "transaction_sha256",
    "intent_sha256",
    "requested_profile",
    "requested_capabilities",
    "data_scope",
    "subjects_sha256",
    "claim_secret_sha256",
    "usd_price_micros",
    "sol_usd_price_micros",
    "oracle_source_id",
    "oracle_published_at",
    "oracle_confidence_bps",
    "lamports_due",
    "issued_at",
    "expires_at",
    "pricing_policy_version",
    "pricing_tier",
    "complexity",
    "max_lamports_requested"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "native_sol_price_quote"
    },
    "quote_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "environment": {
      "enum": [
        "production",
        "sandbox"
      ]
    },
    "network": {
      "enum": [
        "mainnet",
        "devnet",
        "testnet"
      ]
    },
    "genesis_hash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "asset": {
      "const": "SOL"
    },
    "receiver": {
      "type": "string",
      "minLength": 32,
      "maxLength": 44
    },
    "memo_reference": {
      "type": "string",
      "minLength": 10,
      "maxLength": 120
    },
    "message_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "intent_sha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "requested_profile": {
      "enum": [
        "strict",
        "review",
        "explore"
      ]
    },
    "requested_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96
      },
      "uniqueItems": true,
      "maxItems": 64
    },
    "data_scope": {
      "enum": [
        "metadata_only",
        "raw_transaction"
      ]
    },
    "claim_secret_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "usd_price_micros": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$",
      "maxLength": 40
    },
    "sol_usd_price_micros": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$",
      "maxLength": 40
    },
    "oracle_source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "oracle_published_at": {
      "type": "string",
      "format": "date-time"
    },
    "oracle_confidence_bps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "lamports_due": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$",
      "maxLength": 40
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "subjects_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA256 of canonical sorted risk-subject set; paid check cannot expand subjects"
    },
    "pricing_policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "pricing_tier": {
      "enum": [
        "basic",
        "standard",
        "complex",
        "extended"
      ]
    },
    "complexity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transaction_bytes",
        "top_level_instructions",
        "resolved_accounts",
        "lookup_tables",
        "distinct_programs",
        "risk_subjects",
        "verified_from_raw_transaction"
      ],
      "properties": {
        "transaction_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "top_level_instructions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "resolved_accounts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "lookup_tables": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "distinct_programs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "risk_subjects": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "verified_from_raw_transaction": {
          "type": "boolean"
        }
      }
    },
    "max_lamports_requested": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 40
    },
    "transaction_sha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ],
      "description": "Original transaction wire hash if provided; bound to paid check."
    }
  }
}
