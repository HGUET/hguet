{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hguet.fr/schemas/v1/cloud-assessment.schema.json",
  "title": "HGUET CloudAssessment — unreleased wire-schema draft",
  "description": "Server-signed Cloud enrichment for exactly one anonymously paid SOL quote; final CLI SecurityVerdict is separate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "network",
    "genesis_hash",
    "message_sha256",
    "intent_sha256",
    "requested_profile",
    "capabilities_performed",
    "capabilities_unavailable",
    "risk_snapshot_id",
    "ruleset_version",
    "evidence_digest",
    "sources",
    "findings",
    "coverage",
    "issued_at",
    "expires_at",
    "quote_id",
    "environment",
    "data_scope",
    "subjects_sha256",
    "transaction_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "cloud_assessment"
    },
    "network": {
      "enum": [
        "mainnet",
        "devnet",
        "testnet"
      ]
    },
    "genesis_hash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "message_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "intent_sha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "requested_profile": {
      "enum": [
        "strict",
        "review",
        "explore"
      ]
    },
    "capabilities_performed": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96
      }
    },
    "capabilities_unavailable": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96
      }
    },
    "risk_snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "ruleset_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96
    },
    "findings": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "severity",
          "enforcement",
          "evidence_refs"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "severity": {
            "enum": [
              "info",
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "enforcement": {
            "enum": [
              "inform",
              "warn",
              "hard_deny"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "maxLength": 160
            }
          },
          "summary": {
            "type": "string",
            "maxLength": 512
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "passed",
        "unknown"
      ],
      "properties": {
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 96
          }
        },
        "passed": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 96
          }
        },
        "unknown": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 96
          }
        }
      }
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Digest of independently retained/source-attributed evidence manifest used by signed assessment."
    },
    "sources": {
      "type": "array",
      "maxItems": 128,
      "description": "Source provenance; unavailable sources belong in capabilities_unavailable/coverage. No automatic claim of accuracy.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "kind",
          "observed_at",
          "evidence_sha256"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "observed_slot": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "freshness_seconds": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "quote_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$",
      "description": "Same one-off quote_id as original signed price quote and payment receipt."
    },
    "environment": {
      "enum": [
        "production",
        "sandbox"
      ]
    },
    "data_scope": {
      "enum": [
        "metadata_only",
        "raw_transaction"
      ]
    },
    "subjects_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "transaction_sha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
