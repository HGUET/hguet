                    "maxItems": 256
                  },
                  "readonly_indexes": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "maxItems": 256
                  }
                }
              }
            },
            "resource_config": {
              "type": [
                "object",
                "null"
              ]
            },
