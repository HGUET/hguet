                "properties": {
                  "address": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "lookup_table": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "lookup_index": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 255
                  },
                  "required_signer": {
                    "type": "boolean"
                  },
                  "writable": {
                    "type": "boolean"
                  }
                }
              },
              "maxItems": 256
            },
