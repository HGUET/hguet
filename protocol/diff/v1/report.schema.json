                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "lookup_table": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "lookup_index": {
                            "type": [
                              "integer",
                              "null"
                            ],
                            "minimum": 0,
                            "maximum": 255
