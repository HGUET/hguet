                      "accounts": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "address",
                            "lookup_table",
                            "lookup_index",
                            "required_signer",
                            "writable"
                          ],
                          "properties": {
                            "address": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "lookup_table": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "lookup_index": {
                              "type": [
                                "integer",
                                "null"
                              ],
                              "minimum": 0,
                              "maximum": 255
                            },
                            "required_signer": {
                              "type": "boolean"
                            },
                            "writable": {
                              "type": "boolean"
                            }
                          }
                        },
                        "maxItems": 256
                      },
                      "data_sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "data_bytes": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  },
                  "compiled_program_index": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "compiled_account_indices": {
                    "type": "array",
                    "items": {
                      "type": "integer",
