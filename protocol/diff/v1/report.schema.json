                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "lookup_table": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "lookup_index": {
                              "type": [
                                "integer",
                                "null"
                              ],
