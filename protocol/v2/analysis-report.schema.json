{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HGUET Analysis Report v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "kind": {
      "const": "hguet_analysis_report"
    },
    "structural_validity": {
      "enum": [
        "VALID",
        "INVALID",
        "UNKNOWN"
      ]
    },
    "signature_status": {
      "type": [
        "string",
        "null"
      ]
    },
    "policy_compliance": {
      "enum": [
        "MATCH",
        "VIOLATION",
        "UNKNOWN",
        "NOT_CONFIGURED"
      ]
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope",
          "status",
          "limitations"
        ],
        "properties": {
          "scope": {
            "type": "string"
          },
          "status": {
            "const": "PARTIAL"
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "simulation_status": {
      "type": [
        "string",
        "null"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "code",
          "severity",
          "summary",
          "evidence_refs",
          "scope",
          "limitations"
        ],
        "properties": {
          "rule_id": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scope": {
            "type": "string"
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "evidence": {
      "type": "object"
    },
    "signing_authorization": {
      "const": "NOT_AUTHORIZED"
    },
    "exit_code": {
      "enum": [
        0,
        20,
        30,
        40
      ]
    },
    "policy_scope": {
      "const": "configured_local_restrictions_on_original_wire_declarations"
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "program_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_account": {
            "type": [
              "string",
              "null"
            ]
          },
          "destination_account": {
            "type": [
              "string",
              "null"
            ]
          },
          "mint": {
            "type": [
              "string",
              "null"
            ]
          },
          "authority": {
            "type": [
              "string",
              "null"
            ]
          },
          "delegate": {
            "type": [
              "string",
              "null"
            ]
          },
          "new_authority": {
            "type": [
              "string",
              "null"
            ]
          },
          "amount_raw": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "enum": [
              "native_transfer",
              "checked_token_transfer",
              "checked_token_burn",
              "delegate_approval",
              "authority_change",
              "account_closure",
              "unknown"
            ]
          },
          "instruction_index": {
            "type": "integer",
            "minimum": 0
          },
          "source": {
            "const": "original_wire"
          },
          "evidence_ref": {
            "type": "string"
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "authority_type": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 255
          },
          "expected_fee_raw": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "program_id",
          "source_account",
          "destination_account",
          "mint",
          "authority",
          "delegate",
          "new_authority",
          "amount_raw",
          "kind",
          "instruction_index",
          "source",
          "evidence_ref",
          "limitations",
          "authority_type",
          "expected_fee_raw"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "structural_validity",
    "signature_status",
    "policy_compliance",
    "coverage",
    "simulation_status",
    "findings",
    "evidence",
    "signing_authorization",
    "exit_code",
    "policy_scope",
    "effects"
  ]
}
